# Local secrets and environment files
.env
.env.*
!.env.example

# Claude Code / Codex runtime (root copies are locally generated, not shared)
.claude/
.codex/
.agents/
AGENTS.md
CLAUDE.md

# Delivery rules are canonical install sources and must be tracked.
!/delivery/rules/AGENTS.md
!/delivery/rules/CLAUDE.md

# Meta Flow process artifacts (archived to sibling meta-flow-artifacts repo)
# process/ is a symlink -> ../meta-flow-artifacts/process/ptm-atomic
.input/
/process

# Python virtual environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class

# Python build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test, type-check, lint, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Tool caches and local runtime output
.cache/
logs/
*.log

